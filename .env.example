# ── Role ──────────────────────────────────────────────────────────────
# all    = web UI + emulator + streaming on one machine (GPU box)
# web    = web UI / API / auth only (e.g. Railway) — proxies to a gaming server
# gaming = emulator + streaming + input only (GPU cloud VM)
ROLE=all

# ── Web server ──────────────────────────────────────────────────────────
PORT=8080

# ── Auth (change these!) ────────────────────────────────────────────────
AUTH_USER=admin
# bcrypt hash of the password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_PASS_HASH=
# Random secret for signing sessions (generate: openssl rand -hex 32)
SESSION_SECRET=

# ── Split deployment (ROLE=web only) ────────────────────────────────────
# Base URL of the gaming server, e.g. https://gaming.example.com
GAMING_SERVER_URL=
# Shared secret, must match on both sides
GAMING_API_SECRET=

# ── Sessions ────────────────────────────────────────────────────────────
# Max length of one gaming session, in minutes (idle sessions die sooner)
MAX_SESSION_TIME=120
# Kill the session after this many idle minutes (no input)
IDLE_TIMEOUT=15

# ── Stream quality (defaults favor stability over max quality) ──────────
VIDEO_RESOLUTION=1280x720
VIDEO_FPS=30
VIDEO_BITRATE=4000
# Reserved for TURN/STUN relay configuration in advanced setups
WEBRTC_PORT=8889

# ── Paths ───────────────────────────────────────────────────────────────
# Directory where YOU place your legally owned game dumps
# (folders containing PS3_GAME, or .pkg files)
GAME_DIRECTORY=/data/games
# Optional: exact game folder/file name to boot. Empty = first game found.
GAME_ID=
# Where YOU place your legally dumped PS3 firmware (installed via RPCS3)
FIRMWARE_DIRECTORY=/data/firmware
# RPCS3 installation directory / AppImage path
EMULATOR_DIRECTORY=/opt/rpcs3
RPCS3_APPIMAGE=/opt/rpcs3/rpcs3.AppImage

# ── Display (gaming role) ───────────────────────────────────────────────
# X display the emulator runs on (entrypoint starts Xvfb here if needed)
DISPLAY_NUM=99
